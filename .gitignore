# =========================
# WordPress Core
# =========================
/wp-admin/
/wp-includes/

# Root WP files
index.php
license.txt
readme.html
wp-*.php
xmlrpc.php

# =========================
# wp-content
# =========================

# Ignore uploads
/wp-content/uploads/

# Ignore cache
/wp-content/cache/
/wp-content/upgrade/
/wp-content/backup-db/
/wp-content/backups/
/wp-content/blogs.dir/

# Ignore autogenerated plugins
/wp-content/advanced-cache.php
/wp-content/object-cache.php

# =========================
# Plugins
# =========================

# Ignore all plugins except custom ones
/wp-content/plugins/*
!/wp-content/plugins/your-custom-plugin/

# =========================
# Themes
# =========================

# Ignore all themes except custom theme
/wp-content/themes/*
!/wp-content/themes/southernmilestouring/

